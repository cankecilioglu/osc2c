use stdtypes

scenario event_handshake:
    hero : vehicle with:
        keep(it.name == "hero")
    npc : vehicle with:
        keep(it.name == "npc")

    do serial:
        parallel:
            serial:
                wait elapsed(0.2 s)
                emit PING
            serial:
                wait @PING
                emit PONG
        wait elapsed(0.1 s)
        emit DONE
