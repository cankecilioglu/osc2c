use stdtypes

scenario placement_modes:
    hero : vehicle with:
        keep(it.name == "hero")
    npc : vehicle with:
        keep(it.name == "npc")
    follower : vehicle with:
        keep(it.name == "follower")

    do serial:
        hero.assign_position() with:
            position(x: 100 m, y: 5 m, z: 0 m, at: start)
            speed(0 mps, at: start)
        npc.assign_position() with:
            position(distance: 20 m, ahead_of: hero, at: start)
            lane(side: left, side_of: hero, at: start)
            speed(0 mps, at: start)
        follower.assign_position() with:
            position(distance: 8 m, behind: hero, at: start)
            speed(0 mps, at: start)

        wait elapsed(0.2 s)
        emit PLACED
