scenario stage3_fall:
    hero : vehicle

    do serial:
        hero.assign_position() with:
            speed(0 kph, at: start)
        hero.change_speed(target: 10 mps)
        parallel:
            serial:
                wait elapsed(0.2 s)
                hero.change_speed(target: 0 mps)
            wait fall(hero.speed > 5 mps)
        emit STOPPED
